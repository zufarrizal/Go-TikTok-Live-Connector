on block damage:
    set {_toolName} to "%type of player's tool%"
    if {_toolName} does not contain "pickaxe":
        stop

    if event-block is bedrock or cobweb:
        stop

    # Protect temporary dance floor area from custom pickaxe AOE.
    set {_hitLoc} to location of event-block
    loop all players:
        set {_id} to uuid of loop-player
        if {dancefloor.protect.seconds::%{_id}%} is set:
            if {dancefloor.protect.seconds::%{_id}%} > 0:
                set {_dc} to {dancefloor.center::%{_id}%}
                if {_dc} is set:
                    if world of {_hitLoc} is world of {_dc}:
                        set {_minX} to (x-coordinate of {_dc}) - 8
                        set {_maxX} to (x-coordinate of {_dc}) + 8
                        set {_minY} to (y-coordinate of {_dc}) - 2
                        set {_maxY} to (y-coordinate of {_dc}) + 13
                        set {_minZ} to (z-coordinate of {_dc}) - 8
                        set {_maxZ} to (z-coordinate of {_dc}) + 8
                        if x-coordinate of {_hitLoc} >= {_minX}:
                            if x-coordinate of {_hitLoc} <= {_maxX}:
                                if y-coordinate of {_hitLoc} >= {_minY}:
                                    if y-coordinate of {_hitLoc} <= {_maxY}:
                                        if z-coordinate of {_hitLoc} >= {_minZ}:
                                            if z-coordinate of {_hitLoc} <= {_maxZ}:
                                                cancel event
                                                stop

    cancel event
    set {_center} to location of event-block

    set {_yaw} to yaw of player
    set {_dx} to 0
    set {_dz} to 1

    if {_yaw} >= -45:
        if {_yaw} < 45:
            set {_dx} to 0
            set {_dz} to 1
        else if {_yaw} < 135:
            set {_dx} to -1
            set {_dz} to 0
        else:
            set {_dx} to 0
            set {_dz} to -1
    else if {_yaw} >= -135:
        set {_dx} to 1
        set {_dz} to 0
    else:
        set {_dx} to 0
        set {_dz} to -1
    play sound "block.stone.break" with volume 1 and pitch 1 to player
    loop integers between -3 and 3:
        set {_forward} to loop-value-1
        loop integers between -3 and 3:
            set {_side} to loop-value-2
            loop integers between -3 and 3:
                set {_up} to loop-value-3
                set {_loc} to {_center}

                add ({_dx} * {_forward}) to x-coordinate of {_loc}
                add ({_dz} * {_forward}) to z-coordinate of {_loc}

                if {_dx} is not 0:
                    add {_side} to z-coordinate of {_loc}
                else:
                    add {_side} to x-coordinate of {_loc}

                add {_up} to y-coordinate of {_loc}

                set {_protected} to false
                loop all players:
                    set {_id2} to uuid of loop-player
                    if {dancefloor.protect.seconds::%{_id2}%} is set:
                        if {dancefloor.protect.seconds::%{_id2}%} > 0:
                            set {_dc2} to {dancefloor.center::%{_id2}%}
                            if {_dc2} is set:
                                if world of {_loc} is world of {_dc2}:
                                    set {_minX2} to (x-coordinate of {_dc2}) - 8
                                    set {_maxX2} to (x-coordinate of {_dc2}) + 8
                                    set {_minY2} to (y-coordinate of {_dc2}) - 2
                                    set {_maxY2} to (y-coordinate of {_dc2}) + 13
                                    set {_minZ2} to (z-coordinate of {_dc2}) - 8
                                    set {_maxZ2} to (z-coordinate of {_dc2}) + 8
                                    if x-coordinate of {_loc} >= {_minX2}:
                                        if x-coordinate of {_loc} <= {_maxX2}:
                                            if y-coordinate of {_loc} >= {_minY2}:
                                                if y-coordinate of {_loc} <= {_maxY2}:
                                                    if z-coordinate of {_loc} >= {_minZ2}:
                                                        if z-coordinate of {_loc} <= {_maxZ2}:
                                                            set {_protected} to true
                                                            stop loop

                if {_protected} is false:
                    set {_block} to block at {_loc}
                    if {_block} is not bedrock:
                        if {_block} is not cobweb:
                            if {_block} is not tnt:
                                if {_block} is not air:
                                    set {_drops::*} to drops of {_block}
                                    set block at {_loc} to air
                                    loop {_drops::*}:
                                        drop loop-value-4 at {_loc}
