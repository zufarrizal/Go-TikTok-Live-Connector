# Membuat pickaxe menambang area 3x3x3 sekaligus.
on block damage:
    # Only active when the item in hand is a pickaxe
    set {_toolName} to "%type of player's tool%"
    if {_toolName} does not contain "pickaxe":
        stop

    # Bedrock and cobweb cannot be broken
    if event-block is bedrock or cobweb:
        stop

    cancel event
    set {_center} to location of event-block

    # Break a 3x3x3 area (radius 1) around the hit block
    # Tiga loop ini mengecek semua blok di sekitar blok pusat.
    loop integers between -2 and 2:
        loop integers between -2 and 2:
            loop integers between -2 and 2:
                set {_loc} to {_center}
                add loop-value-1 to x-coordinate of {_loc}
                add loop-value-2 to y-coordinate of {_loc}
                add loop-value-3 to z-coordinate of {_loc}

                set {_block} to block at {_loc}
                if {_block} is not bedrock:
                    if {_block} is not cobweb:
                        if {_block} is not air:
                            # Magic block: jangan drop block aslinya, langsung ganti diamond random.
                            if {random_diamond_block::%{_loc}%} is set:
                                # Hanya boleh dihancurkan jika block yang dipukul langsung
                                # dan tool adalah golden pickaxe.
                                if {_loc} is location of event-block:
                                    if {_toolName} is "golden pickaxe":
                                        set {random_diamond_block_breaking::%{_loc}%} to true
                                        delete {random_diamond_block::%{_loc}%}
                                        remove {_loc} from {random_diamond_block_locations::*}
                                        set block at {_loc} to air
                                        set {_dropAmount} to random integer between 1 and 20
                                        play sound "block.stone.break" with volume 1 and pitch 1 to player
                                        drop {_dropAmount} of diamond at {_loc}
                                    else:
                                        send "&cMagic block hanya bisa dihancurkan dengan golden pickaxe." to player
                            else:
                                # Ambil drop asli blok, lalu hancurkan blok tersebut.
                                set {_drops::*} to drops of {_block}
                                set block at {_loc} to air
                                play sound "block.stone.break" with volume 1 and pitch 1 to player
                                loop {_drops::*}:
                                    drop loop-value-4 at {_loc}
