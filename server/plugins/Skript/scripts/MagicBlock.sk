# RandomDiamondBlock.sk
# Command untuk membuat block khusus 2 block di depan player.
# Saat block itu dihancurkan, akan drop diamond dengan jumlah acak.

function play_magic_fireworks(p: player):
    loop 3 times:
        execute console command "execute at %{_p}% run particle firework ~ ~1 ~ 0.35 0.35 0.35 0.1 80 force @a"
        execute console command "execute at %{_p}% run particle dust{color:[1.0,0.0,0.0],scale:1.3} ~ ~1 ~ 0.5 0.5 0.5 0 25 force @a"
        execute console command "execute at %{_p}% run particle dust{color:[1.0,1.0,0.0],scale:1.3} ~ ~1 ~ 0.5 0.5 0.5 0 25 force @a"
        execute console command "execute at %{_p}% run particle dust{color:[1.0,1.0,1.0],scale:1.3} ~ ~1 ~ 0.5 0.5 0.5 0 25 force @a"
        execute console command "execute at %{_p}% run playsound entity.firework_rocket.large_blast master @a ~ ~ ~ 1 1"
        wait 6 ticks

command /magicblock <text>:
    trigger:
        if player is set:
            set {_target} to player
        else:
            if number of all players is 0:
                send "&cTidak ada player online untuk target @p." to console
                stop
            set {_target} to a random player out of all players

        set {_loc} to location of block 2 meters in front of {_target}
        add 1 to y-coordinate of {_loc}

        if {random_diamond_block::%{_loc}%} is set:
            delete {random_diamond_block::%{_loc}%}
        remove {_loc} from {random_diamond_block_locations::*}
        set block at {_loc} to gold block
        set {random_diamond_block::%{_loc}%} to true
        add {_loc} to {random_diamond_block_locations::*}
        send title "&6&l%arg-1%" with subtitle "&aSent MAGIC BLOCK" to players

every 5 ticks:
    loop {random_diamond_block_locations::*}:
        set {_loc} to loop-value

        # Jika block sudah hilang (air), bersihkan data.
        if block at {_loc} is air:
            delete {random_diamond_block::%{_loc}%}
            remove {_loc} from {random_diamond_block_locations::*}
        else:
            set {_roll} to random integer between 1 and 5
            if {_roll} is 1:
                set block at {_loc} to iron block
            else if {_roll} is 2:
                set block at {_loc} to gold block
            else if {_roll} is 3:
                set block at {_loc} to diamond block
            else if {_roll} is 4:
                set block at {_loc} to netherite block
            else:
                set block at {_loc} to emerald block

on block damage:
    if {random_diamond_block::%location of event-block%} is set:
        cancel event
        delete {random_diamond_block::%location of event-block%}
        remove location of event-block from {random_diamond_block_locations::*}
        set block at location of event-block to air

        set {_dropAmount} to random integer between 1 and 20
        drop {_dropAmount} of diamond at location of event-block
        send "&bKamu mendapatkan %{_dropAmount}% diamond." to player
        play_magic_fireworks(player)

on break:
    if {random_diamond_block::%location of event-block%} is set:
        delete {random_diamond_block::%location of event-block%}
        remove location of event-block from {random_diamond_block_locations::*}
        clear drops

        set {_dropAmount} to random integer between 1 and 20
        drop {_dropAmount} of diamond at location of event-block

        if player is set:
            send "&bKamu mendapatkan %{_dropAmount}% diamond." to player
            play_magic_fireworks(player)
