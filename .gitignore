# Default: ignore everything
*

# Allow traversing directories so specific files can be re-included
!*/

# Always allow Skript files anywhere
!*.sk
!*.html
!*.css
!*.js

# Allow all files that currently exist in this repository
!.gitignore
!LICENSE
!README.md
!go.mod
!go.sum
!main.go
!shortcut_windows.go
!shortcut_nonwindows.go
!watermark.go
!server/eula.txt
!server/paper.jar
!server/plugins/ServerTap-0.6.1.jar
!server/plugins/Skript-2.14.3.jar
!server/server.properties
!server/start-server.bat
!web/index.html
!web/overlay-like-goal.html
!web/static/app.js
!web/static/overlay-like-goal.js
!web/static/styles.css
!web/static/flags/
!web/static/flags/*.svg
!web/static/vendor/html2canvas.min.js

# Allow third_party gotiktoklive fork (custom GroupID support)
!third_party/
!third_party/gotiktoklive/
!third_party/gotiktoklive/*.go
!third_party/gotiktoklive/*.mod
!third_party/gotiktoklive/*.sum
!third_party/gotiktoklive/proto/
!third_party/gotiktoklive/proto/*.go
!third_party/gotiktoklive/proto/*.proto
