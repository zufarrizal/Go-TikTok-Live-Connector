
function normalize_win_total():
    if {win.total} is not set:
        set {win.total} to 0

function normalize_win_target():
    if {win.target} is not set:
        set {win.target} to 10
    if {win.target} <= 0:
        set {win.target} to 1

function format_three_digits(n: number) :: text:
    set {_num} to {_n}
    set {_abs} to {_num}
    if {_abs} < 0:
        set {_abs} to 0 - {_abs}

    if {_abs} < 10:
        set {_text} to "00%{_abs}%"
    else if {_abs} < 100:
        set {_text} to "0%{_abs}%"
    else:
        set {_text} to "%{_abs}%"

    if {_num} < 0:
        set {_text} to "-%{_text}%"

    return {_text}

function update_win_scoreboard():
    normalize_win_total()
    normalize_win_target()
    if {scoreboard.win.line} is set:
        execute console command "scoreboard players reset %{scoreboard.win.line}% diamond_count"
    set {_line} to colored "&6&lWIN:&f%{win.total}%&7/&e%{win.target}%"
    set {scoreboard.win.line} to {_line}
    execute console command "scoreboard players set %{_line}% diamond_count 1"

function update_player_scoreboard(p: player):
    set {_count} to {diamond.balance::%uuid of {_p}%}
    if {_count} is not set:
        set {_count} to 0
    set {_countText} to format_three_digits({_count})
    set {_targetText} to format_three_digits({diamond.target})
    set {diamond.lastscore::%uuid of {_p}%} to {_count}
    if {scoreboard.diamond.line} is set:
        execute console command "scoreboard players reset %{scoreboard.diamond.line}% diamond_count"
    execute console command "scoreboard players reset %{_p}% diamond_count"
    set {_line} to colored "&b&lDiamond:&f%{_countText}%&7/&e%{_targetText}%"
    set {scoreboard.diamond.line} to {_line}
    execute console command "scoreboard players set %{_line}% diamond_count 2"

on load:
    if {diamond.target} is not set:
        set {diamond.target} to 256
    normalize_win_total()
    normalize_win_target()
    delete {diamond.lastscore::*}
    delete {scoreboard.diamond.line}
    delete {scoreboard.win.line}
    delete {win.firework.active}
    delete {addwin.firework.seconds}
    execute console command "scoreboard objectives remove diamond_count"
    execute console command "scoreboard objectives add diamond_count dummy SCOREBOARD"
    execute console command "scoreboard objectives modify diamond_count numberformat blank"
    execute console command "scoreboard objectives setdisplay sidebar diamond_count"
    update_win_scoreboard()
    loop all players:
        update_player_scoreboard(loop-player)

on join:
    if {diamond.debt::%uuid of player%} is not set:
        set {diamond.debt::%uuid of player%} to 0
    if {diamond.target} is not set:
        set {diamond.target} to 256
    normalize_win_total()
    normalize_win_target()
    execute console command "scoreboard objectives setdisplay sidebar diamond_count"
    update_win_scoreboard()
    set {diamond.balance::%uuid of player%} to (amount of diamond in player's inventory) - {diamond.debt::%uuid of player%}
    update_player_scoreboard(player)

every 10 ticks:
    loop all players:
        if {diamond.debt::%uuid of loop-player%} is not set:
            set {diamond.debt::%uuid of loop-player%} to 0

        set {_debt} to {diamond.debt::%uuid of loop-player%}
        set {_inv} to amount of diamond in loop-player's inventory

        if {_debt} > 0:
            set {_use} to {_inv}
            if {_use} > {_debt}:
                set {_use} to {_debt}
            if {_use} > 0:
                remove {_use} of diamond from loop-player's inventory
                remove {_use} from {diamond.debt::%uuid of loop-player%}
                remove {_use} from {_inv}
                remove {_use} from {_debt}

        set {_count} to {_inv} - {_debt}

        set {_target} to {diamond.target}

        set {diamond.balance::%uuid of loop-player%} to {_count}
        if {diamond.lastscore::%uuid of loop-player%} is not {_count}:
            update_player_scoreboard(loop-player)

        if {_count} >= {_target}:
            if {win.countdown::%uuid of loop-player%} is not set:
                set {win.countdown::%uuid of loop-player%} to 15
        else:
            delete {win.countdown::%uuid of loop-player%}

every 1 tick:
    loop all players:
        set {_id} to uuid of loop-player
        if {freeze.seconds::%{_id}%} is set:
            if {freeze.seconds::%{_id}%} > 0:
                if {freeze.lockloc::%{_id}%} is set:
                    teleport loop-player to {freeze.lockloc::%{_id}%}
                else:
                    set {freeze.lockloc::%{_id}%} to location of loop-player
            else:
                delete {freeze.lockloc::%{_id}%}
        else:
            delete {freeze.lockloc::%{_id}%}

every 1 second:
    loop all players:
        if {win.countdown::%uuid of loop-player%} is set:
            set {_bal} to {diamond.balance::%uuid of loop-player%}
            set {_target} to {diamond.target}
            if {_bal} < {_target}:
                delete {win.countdown::%uuid of loop-player%}
                delete {win.countdown.slow::%uuid of loop-player%}
                delete {win.countdown.slowticks::%uuid of loop-player%}
                delete {win.countdown.zero::%uuid of loop-player%}
                delete {win.countdown.lastshown::%uuid of loop-player%}
            else:
                set {_left} to {win.countdown::%uuid of loop-player%}
                if {win.countdown.lastshown::%uuid of loop-player%} is not {_left}:
                    set {win.countdown.lastshown::%uuid of loop-player%} to {_left}
                    send title "&b&lDIAMOND &f&lTARGET!" with subtitle "&e&lWIN IN &c%{_left}% &6SECONDS" to loop-player
                    play sound "block.note_block.hat" to loop-player

                if {_left} <= 0:
                    if {win.countdown.zero::%uuid of loop-player%} is not set:
                        set {win.countdown.zero::%uuid of loop-player%} to true
                    else:
                        delete {win.countdown::%uuid of loop-player%}
                        delete {win.countdown.slow::%uuid of loop-player%}
                        delete {win.countdown.slowticks::%uuid of loop-player%}
                        delete {win.countdown.zero::%uuid of loop-player%}
                        delete {win.countdown.lastshown::%uuid of loop-player%}
                        send title "&6&lWIN &e&lPLAYER!" with subtitle "&b&l%loop-player%" to players
                        broadcast "&6WIN Player: &e%loop-player%"
                        add 1 to {win.last.id}
                        set {win.last.uuid} to uuid of loop-player
                        add 1 to {win.total}
                        update_win_scoreboard()
                        remove {_target} of diamond from loop-player's inventory
                        set {_bal} to (amount of diamond in loop-player's inventory) - {diamond.debt::%uuid of loop-player%}
                        set {diamond.balance::%uuid of loop-player%} to {_bal}
                        update_player_scoreboard(loop-player)
                else:
                    delete {win.countdown.zero::%uuid of loop-player%}
                    if {_left} <= 3:
                        add 1 to {win.countdown.slowticks::%uuid of loop-player%}
                        if {win.countdown.slowticks::%uuid of loop-player%} < 3:
                            set {win.countdown.slow::%uuid of loop-player%} to true
                        else:
                            delete {win.countdown.slow::%uuid of loop-player%}
                            delete {win.countdown.slowticks::%uuid of loop-player%}
                            remove 1 from {win.countdown::%uuid of loop-player%}
                    else:
                        delete {win.countdown.slow::%uuid of loop-player%}
                        delete {win.countdown.slowticks::%uuid of loop-player%}
                        remove 1 from {win.countdown::%uuid of loop-player%}

    loop all players:
        set {_id} to uuid of loop-player
        if {dancefloor.protect.seconds::%{_id}%} is set:
            remove 1 from {dancefloor.protect.seconds::%{_id}%}
            if {dancefloor.protect.seconds::%{_id}%} <= 0:
                delete {dancefloor.protect.seconds::%{_id}%}
                delete {dancefloor.center::%{_id}%}
        if {freeze.seconds::%{_id}%} is set:
            remove 1 from {freeze.seconds::%{_id}%}
            if {freeze.seconds::%{_id}%} <= 0:
                delete {freeze.seconds::%{_id}%}
                delete {freeze.lockloc::%{_id}%}

    if {addwin.firework.seconds} is set:
        remove 1 from {addwin.firework.seconds}
        if {addwin.firework.seconds} <= 0:
            delete {addwin.firework.seconds}

every 5 ticks:
    normalize_win_total()
    normalize_win_target()

    if {win.total} >= {win.target}:
        if {win.firework.active} is not set:
            set {win.firework.active} to true
            broadcast "&6WIN target reached! &eFirework celebration started."

        loop all players:
            set {_rx1} to random integer between -3 and 3
            set {_ry1} to random integer between 1 and 4
            set {_rz1} to random integer between -3 and 3
            execute console command "execute at %loop-player% run particle dust{color:[1.0,0.1,0.1],scale:1.4} ~%{_rx1}% ~%{_ry1}% ~%{_rz1}% 0.35 0.35 0.35 0.08 45 force @a"

            set {_rx2} to random integer between -3 and 3
            set {_ry2} to random integer between 1 and 4
            set {_rz2} to random integer between -3 and 3
            execute console command "execute at %loop-player% run particle dust{color:[1.0,0.9,0.0],scale:1.4} ~%{_rx2}% ~%{_ry2}% ~%{_rz2}% 0.35 0.35 0.35 0.08 45 force @a"

            set {_rx3} to random integer between -3 and 3
            set {_ry3} to random integer between 1 and 4
            set {_rz3} to random integer between -3 and 3
            execute console command "execute at %loop-player% run particle dust{color:[0.1,1.0,0.1],scale:1.4} ~%{_rx3}% ~%{_ry3}% ~%{_rz3}% 0.35 0.35 0.35 0.08 45 force @a"

            set {_rx4} to random integer between -3 and 3
            set {_ry4} to random integer between 1 and 4
            set {_rz4} to random integer between -3 and 3
            execute console command "execute at %loop-player% run particle dust{color:[1.0,1.0,1.0],scale:1.4} ~%{_rx4}% ~%{_ry4}% ~%{_rz4}% 0.35 0.35 0.35 0.08 45 force @a"
    else:
        if {win.firework.active} is set:
            delete {win.firework.active}
            broadcast "&eWIN celebration stopped. Increase current win to reach target again."

    if {addwin.firework.seconds} is set:
        if {addwin.firework.seconds} > 0:
            loop all players:
                set {_arx1} to random integer between -3 and 3
                set {_ary1} to random integer between 1 and 4
                set {_arz1} to random integer between -3 and 3
                execute console command "execute at %loop-player% run particle dust{color:[1.0,0.1,0.1],scale:1.4} ~%{_arx1}% ~%{_ary1}% ~%{_arz1}% 0.35 0.35 0.35 0.08 45 force @a"

                set {_arx2} to random integer between -3 and 3
                set {_ary2} to random integer between 1 and 4
                set {_arz2} to random integer between -3 and 3
                execute console command "execute at %loop-player% run particle dust{color:[1.0,0.9,0.0],scale:1.4} ~%{_arx2}% ~%{_ary2}% ~%{_arz2}% 0.35 0.35 0.35 0.08 45 force @a"

                set {_arx3} to random integer between -3 and 3
                set {_ary3} to random integer between 1 and 4
                set {_arz3} to random integer between -3 and 3
                execute console command "execute at %loop-player% run particle dust{color:[0.1,1.0,0.1],scale:1.4} ~%{_arx3}% ~%{_ary3}% ~%{_arz3}% 0.35 0.35 0.35 0.08 45 force @a"

                set {_arx4} to random integer between -3 and 3
                set {_ary4} to random integer between 1 and 4
                set {_arz4} to random integer between -3 and 3
                execute console command "execute at %loop-player% run particle dust{color:[1.0,1.0,1.0],scale:1.4} ~%{_arx4}% ~%{_ary4}% ~%{_arz4}% 0.35 0.35 0.35 0.08 45 force @a"

command /dmmin <number> <text> <number>:
    trigger:
        set {_total} to arg-1 * arg-3
        if {_total} <= 0:
            send "&cAmount must be greater than 0."
            stop

        send title "&6&l%arg-2%" with subtitle "&c&lTAKE &e%{_total}% &fDiamonds" to players
        loop all players:
            if {diamond.debt::%uuid of loop-player%} is not set:
                set {diamond.debt::%uuid of loop-player%} to 0

            set {_left} to {_total}
            set {_inv} to amount of diamond in loop-player's inventory
            set {_take} to {_inv}
            if {_take} > {_left}:
                set {_take} to {_left}

            if {_take} > 0:
                remove {_take} of diamond from loop-player's inventory
                remove {_take} from {_left}

            if {_left} > 0:
                add {_left} to {diamond.debt::%uuid of loop-player%}

            set {_bal} to (amount of diamond in loop-player's inventory) - {diamond.debt::%uuid of loop-player%}
            set {diamond.balance::%uuid of loop-player%} to {_bal}
            update_player_scoreboard(loop-player)
            play sound "entity.experience_orb.pickup" to loop-player

command /dmset <number>:
    trigger:
        if arg-1 <= 0:
            send "&cTarget diamond must be greater than 0."
            stop

        set {diamond.target} to arg-1
        delete {win.countdown::*}
        delete {diamond.lastscore::*}
        loop all players:
            update_player_scoreboard(loop-player)
        broadcast "&eDiamond win target set to &a%arg-1%&e."

command /winreset:
    trigger:
        set {win.total} to 0
        update_win_scoreboard()
        broadcast "&eWIN score has been reset to &a0&e."

command /setwintarget <number>:
    trigger:
        if arg-1 <= 0:
            send "&cWIN target must be greater than 0."
            stop

        set {win.target} to arg-1
        update_win_scoreboard()
        broadcast "&eWIN target has been set to &a%{win.target}%&e."

command /addwintarget <number>:
    trigger:
        if arg-1 <= 0:
            send "&cWIN target addition must be greater than 0."
            stop

        normalize_win_target()
        add arg-1 to {win.target}
        update_win_scoreboard()
        broadcast "&eWIN target increased by &a%arg-1%&e. Target: &6%{win.target}%&e."

command /minwintarget <number>:
    trigger:
        if arg-1 <= 0:
            send "&cWIN target reduction must be greater than 0."
            stop

        normalize_win_target()
        remove arg-1 from {win.target}
        if {win.target} <= 0:
            set {win.target} to 1
        update_win_scoreboard()
        broadcast "&eWIN target reduced by &c%arg-1%&e. Target: &6%{win.target}%&e."

command /winset <number>:
    trigger:
        set {win.total} to arg-1
        normalize_win_total()
        update_win_scoreboard()
        broadcast "&eWIN score has been set to &a%arg-1%&e."

command /addwin <number> <text> <number>:
    trigger:
        set {_total} to arg-1 * arg-3
        if {_total} <= 0:
            send "&cWIN addition must be greater than 0."
            stop

        normalize_win_total()
        add {_total} to {win.total}
        send title "&6&l%arg-2%" with subtitle "&a&lADD &e%{_total}% &fWin" to players
        update_win_scoreboard()
        set {addwin.firework.seconds} to 15

        # addwin only: teleport players to top Y + 1, clear 15x15x15, then build 15x15 dance floor
        loop all players:
            set {_tpLoc} to location of loop-player
            set {_topBlock} to highest block at {_tpLoc}
            set y-coordinate of {_tpLoc} to y-coordinate of {_topBlock}
            add 1 to y-coordinate of {_tpLoc}
            teleport loop-player to {_tpLoc}

            execute console command "execute at %loop-player% run fill ~-7 ~-1 ~-7 ~7 ~13 ~7 minecraft:air replace"
            execute console command "execute at %loop-player% run fill ~-7 ~-1 ~-7 ~7 ~-1 ~7 minecraft:sea_lantern replace"
            execute console command "execute at %loop-player% run fill ~-8 ~-2 ~-8 ~-6 ~-2 ~-6 minecraft:iron_block replace"
            execute console command "execute at %loop-player% run fill ~6 ~-2 ~-8 ~8 ~-2 ~-6 minecraft:iron_block replace"
            execute console command "execute at %loop-player% run fill ~-8 ~-2 ~6 ~-6 ~-2 ~8 minecraft:iron_block replace"
            execute console command "execute at %loop-player% run fill ~6 ~-2 ~6 ~8 ~-2 ~8 minecraft:iron_block replace"
            execute console command "execute at %loop-player% run setblock ~-7 ~-1 ~-7 minecraft:beacon replace"
            execute console command "execute at %loop-player% run setblock ~7 ~-1 ~-7 minecraft:beacon replace"
            execute console command "execute at %loop-player% run setblock ~-7 ~-1 ~7 minecraft:beacon replace"
            execute console command "execute at %loop-player% run setblock ~7 ~-1 ~7 minecraft:beacon replace"
            set {dancefloor.protect.seconds::%uuid of loop-player%} to 15
            set {dancefloor.center::%uuid of loop-player%} to location of loop-player
            set {freeze.seconds::%uuid of loop-player%} to 1
            set {freeze.lockloc::%uuid of loop-player%} to location of loop-player

        # blink dance floor: random block per tile (not one block type for whole floor), 15 seconds total
        loop 38 times:
            loop all players:
                set {_p} to loop-player
                execute console command "execute at %{_p}% run fill ~-7 ~-1 ~-7 ~7 ~-1 ~7 minecraft:air replace"
                set {_x} to -7
                while {_x} <= 7:
                    set {_z} to -7
                    while {_z} <= 7:
                        set {_rnd} to random integer between 1 and 6
                        if {_rnd} = 1:
                            set {_danceBlock} to "minecraft:sea_lantern"
                        else if {_rnd} = 2:
                            set {_danceBlock} to "minecraft:glowstone"
                        else if {_rnd} = 3:
                            set {_danceBlock} to "minecraft:shroomlight"
                        else if {_rnd} = 4:
                            set {_danceBlock} to "minecraft:ochre_froglight"
                        else if {_rnd} = 5:
                            set {_danceBlock} to "minecraft:pearlescent_froglight"
                        else:
                            set {_danceBlock} to "minecraft:verdant_froglight"

                        execute console command "execute at %{_p}% run setblock ~%{_x}% ~-1 ~%{_z}% %{_danceBlock}% replace"
                        add 1 to {_z}
                    add 1 to {_x}
                execute console command "execute at %{_p}% run setblock ~-7 ~-1 ~-7 minecraft:beacon replace"
                execute console command "execute at %{_p}% run setblock ~7 ~-1 ~-7 minecraft:beacon replace"
                execute console command "execute at %{_p}% run setblock ~-7 ~-1 ~7 minecraft:beacon replace"
                execute console command "execute at %{_p}% run setblock ~7 ~-1 ~7 minecraft:beacon replace"
            wait 8 ticks

        # remove temporary arena after 15 seconds
        loop all players:
            execute console command "execute at %loop-player% run fill ~-8 ~-2 ~-8 ~8 ~13 ~8 minecraft:air replace"
            delete {dancefloor.protect.seconds::%uuid of loop-player%}
            delete {dancefloor.center::%uuid of loop-player%}
            delete {freeze.seconds::%uuid of loop-player%}
            delete {freeze.lockloc::%uuid of loop-player%}

        broadcast "&eWIN score increased by &a%{_total}%&e. Total: &6%{win.total}%&e."

command /minwin <number> <text> <number>:
    trigger:
        set {_total} to arg-1 * arg-3
        if {_total} <= 0:
            send "&cWIN reduction must be greater than 0."
            stop

        normalize_win_total()

        remove {_total} from {win.total}
        send title "&6&l%arg-2%" with subtitle "&c&lTAKE &e%{_total}% &fWin" to players

        update_win_scoreboard()
        broadcast "&eWIN score reduced by &c%{_total}%&e. Total: &6%{win.total}%&e."

command /reducewin <number> <text> <number>:
    trigger:
        execute player command "minwin %arg-1% %arg-2% %arg-3%"

command /winmin <number> <text> <number>:
    trigger:
        execute player command "minwin %arg-1% %arg-2% %arg-3%"

on break:
    set {_bLoc} to location of event-block
    loop all players:
        set {_id} to uuid of loop-player
        if {dancefloor.protect.seconds::%{_id}%} is set:
            if {dancefloor.protect.seconds::%{_id}%} > 0:
                set {_center} to {dancefloor.center::%{_id}%}
                if {_center} is set:
                    if world of {_bLoc} is world of {_center}:
                        set {_minX} to (x-coordinate of {_center}) - 8
                        set {_maxX} to (x-coordinate of {_center}) + 8
                        set {_minY} to (y-coordinate of {_center}) - 2
                        set {_maxY} to (y-coordinate of {_center}) + 13
                        set {_minZ} to (z-coordinate of {_center}) - 8
                        set {_maxZ} to (z-coordinate of {_center}) + 8

                        if x-coordinate of {_bLoc} >= {_minX}:
                            if x-coordinate of {_bLoc} <= {_maxX}:
                                if y-coordinate of {_bLoc} >= {_minY}:
                                    if y-coordinate of {_bLoc} <= {_maxY}:
                                        if z-coordinate of {_bLoc} >= {_minZ}:
                                            if z-coordinate of {_bLoc} <= {_maxZ}:
                                                cancel event
                                                stop
