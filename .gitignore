# Ignore everything by default
*

# Runtime cache/output that must never be committed
giftimage/

# Keep gitignore itself
!.gitignore

# Keep required root files
!go.mod
!go.sum
!LICENSE
!main.go
!README
!README.md

# Keep web folder and all contents
!web/
!web/**

# Allow traversing server tree, then keep only specific files
!server/
!server/**/
server/**
!server/**/*.sk
!server/**/Skript-2.14.3.jar
